{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "twin-webapp",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "traffic_twin.webapp",
        "--port",
        "8765"
      ],
      "port": 8765
    },
    {
      "name": "fatmawati-3d",
      "runtimeExecutable": "python3",
