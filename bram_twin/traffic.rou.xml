<routes>
  <vType id="moto"      vClass="motorcycle" length="2" width="0.8" latAlignment="arbitrary"/>
  <vType id="car"       vClass="passenger"/>
  <vType id="ambulance" vClass="emergency" color="1,1,0"/>

  <flow id="NS_moto" type="moto" from="N2C" to="C2S" begin="0" end="3600" probability="0.167"/>
  <flow id="NS_car"  type="car"  from="N2C" to="C2S" begin="0" end="3600" probability="0.042"/>
  <flow id="EW_moto" type="moto" from="E2C" to="C2W" begin="0" end="3600" probability="0.139"/>
  <flow id="EW_car"  type="car"  from="E2C" to="C2W" begin="0" end="3600" probability="0.033"/>
  <flow id="SN_moto" type="moto" from="S2C" to="C2N" begin="0" end="3600" probability="0.111"/>
  <flow id="WE_moto" type="moto" from="W2C" to="C2E" begin="0" end="3600" probability="0.111"/>
  <flow id="NE_car"  type="car"  from="N2C" to="C2E" begin="0" end="3600" probability="0.028"/>

  <!-- ambulances: one every 310 s from three directions, so they arrive at different moments of the signal cycle -->
  <flow id="ambN" type="ambulance" from="N2C" to="C2S" begin="60"  end="3600" period="310"/>
  <flow id="ambE" type="ambulance" from="E2C" to="C2W" begin="140" end="3600" period="310"/>
  <flow id="ambW" type="ambulance" from="W2C" to="C2E" begin="220" end="3600" period="310"/>
</routes>